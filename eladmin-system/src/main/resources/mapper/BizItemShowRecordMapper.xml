	</update>



    <select id="selectAll" resultMap="bizItemShowRecordResultMap">
        select <include refid="table_columns" />
        from biz_item_show_record
    </select>

    <select id="select" resultMap="bizItemShowRecordResultMap">
        select <include refid="table_columns" />
        from biz_item_show_record
        <include refid="page_where" />
	</select>

    <select id="getCount" resultType="int" >
        select count(id) from biz_item_show_record
        <include refid="page_where" />
    </select>


    <select id="getByPrimaryKey" resultMap="bizItemShowRecordResultMap" parameterType="Long" >
		select <include refid="table_columns" />
		from biz_item_show_record
		where id = #{id}
	</select>
	
	<!-- 其他自定义SQL -->


</mapper>